      }
    ]
  },
  {
    "dialogue_id": "hsk1_dialogue07",
    "title": "Ở trường",
    "turns": [
      {
        "turn_id": "hsk1_dialogue07_turn01",
        "speaker": "A",
        "hanzi": "你叫什么名字？",
        "pinyin": "Nǐ jiào shénme míngzi?",
        "meaning": "Bạn tên là gì?",
        "audio_path": "dialogue_b3_01_01.mp3"
      },
      {
        "turn_id": "hsk1_dialogue07_turn02",
        "speaker": "B",
        "hanzi": "我叫李月。",
        "pinyin": "Wǒ jiào Lǐ Yuè.",
        "meaning": "Tôi tên là Lý Nguyệt.",
        "audio_path": "dialogue_b3_01_02.mp3"
      }
    ]
  },
  {
    "dialogue_id": "hsk1_dialogue08",
    "title": "Trong lớp học",
    "turns": [
      {
        "turn_id": "hsk1_dialogue08_turn01",
        "speaker": "A",
        "hanzi": "你是老师吗？",
        "pinyin": "Nǐ shì lǎoshī ma?",
        "meaning": "Bạn là giáo viên phải không?",
        "audio_path": "dialogue_b3_02_01.mp3"
      },
      {
        "turn_id": "hsk1_dialogue08_turn02",
        "speaker": "B",
        "hanzi": "我不是老师，我是学生。",
        "pinyin": "Wǒ bú shì lǎoshī, wǒ shì xuésheng.",
        "meaning": "Tôi không phải giáo viên, tôi là học sinh.",
        "audio_path": "dialogue_b3_02_02.mp3"
      }
    ]
  },
  {
    "dialogue_id": "hsk1_dialogue09",
    "title": "Hỏi quốc tịch",
    "turns": [
      {
        "turn_id": "hsk1_dialogue09_turn01",
        "speaker": "A",
        "hanzi": "你是中国人吗？",
        "pinyin": "Nǐ shì Zhōngguó rén ma?",
        "meaning": "Bạn là người Trung Quốc phải không?",
        "audio_path": "dialogue_b3_03_01.mp3"
      },
      {
        "turn_id": "hsk1_dialogue09_turn02",
        "speaker": "B",
        "hanzi": "我不是中国人，我是美国人。",
        "pinyin": "Wǒ bú shì Zhōngguó rén, wǒ shì Měiguó rén.",
        "meaning": "Tôi không phải người Trung Quốc, tôi là người Mỹ.",
        "audio_path": "dialogue_b3_03_02.mp3"
      }
    ]
  },
  {
    "dialogue_id": "hsk1_dialogue10",
    "title": "Vận dụng tự giới thiệu",
    "turns": [
      {
        "turn_id": "hsk1_dialogue10_turn01",
        "speaker": "A",
        "hanzi": "我叫李月，我是中国人，我是老师。",
        "pinyin": "Wǒ jiào Lǐ Yuè, wǒ shì Zhōngguó rén, wǒ shì lǎoshī.",
        "meaning": "Tôi tên Lý Nguyệt, tôi là người Trung Quốc, tôi là giáo viên.",
        "audio_path": "application_b3_intro_01.mp3"
      },
      {
        "turn_id": "hsk1_dialogue10_turn02",
        "speaker": "B",
        "hanzi": "我叫大卫，我是美国人，我是学生。",
        "pinyin": "Wǒ jiào Dàwèi, wǒ shì Měiguó rén, wǒ shì xuésheng.",
        "meaning": "Tôi tên David, tôi là người Mỹ, tôi là học sinh.",
        "audio_path": "application_b3_intro_02.mp3"
      }
    ]
  }
]