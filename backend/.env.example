PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# For PostgreSQL in Production:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ChinaEasyDB?schema=public"

# JWT configuration (UC01)
JWT_ACCESS_SECRET="chinaeasy_super_secret_access_jwt_key_2026_xyz"
JWT_REFRESH_SECRET="chinaeasy_super_secret_refresh_jwt_key_2026_abc"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis Cache & Session configuration
REDIS_URL="redis://127.0.0.1:6379"
USE_MEMORY_REDIS=true

# Google OAuth2 configuration
GOOGLE_CLIENT_ID="mock-google-client-id-chinaeasy.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="mock-google-client-secret"

# Frontend Client URL for CORS
CLIENT_URL="http://localhost:5173"
