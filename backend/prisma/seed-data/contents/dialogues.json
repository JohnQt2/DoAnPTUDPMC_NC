  {
    "dialogue_id": "hsk1_dialogue03",
    "title": "Xin lỗi & Đáp lại",
    "audio_path": "audio/hsk1/lesson01/dialogue/dlg3.mp3",
    "turns": [
      {
        "speaker": "A",
        "hanzi": "对不起！",
        "pinyin": "Duìbuqǐ!",
        "meaning": "Xin lỗi!"
      },
      {
        "speaker": "B",
        "hanzi": "没关系！",
        "pinyin": "Méi guānxi!",
        "meaning": "Không sao đâu!"
      }
    ]
  },
  
  {
    "dialogue_id": "hsk1_dialogue04",
    "title": "Cảm ơn và đáp lại",
