PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# For PostgreSQL in Production:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ChinaEasyDB?schema=public"

# JWT configuration (UC01)
JWT_ACCESS_SECRET="chinaeasy_super_secret_access_jwt_key_2026_xyz"
JWT_REFRESH_SECRET="chinaeasy_super_secret_refresh_jwt_key_2026_abc"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis Cache & Session configuration
REDIS_URL="redis://127.0.0.1:6379"
USE_MEMORY_REDIS=true

# Google OAuth2 configuration (Google Identity Services & Authorization Code Flow)
GOOGLE_CLIENT_ID="236710689789-ipu0ad4sdke0paakb5ujmu0ukq9b4mc9.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# Frontend Client URL for CORS
CLIENT_URL="http://localhost:5175"

# Gmail SMTP Configuration for sending real Email OTP (@gmail.com)
# - Để TRỐNG SMTP_USER / SMTP_PASS nếu muốn dùng tài khoản gửi mặc định của dự án.
# - Muốn dùng Gmail riêng: bật Xác minh 2 bước -> tạo App Password tại https://myaccount.google.com/apppasswords
#   rồi điền Gmail vào SMTP_USER và mã 16 ký tự vào SMTP_PASS (KHÔNG dùng mật khẩu Gmail thường).
# - Kiểm tra cấu hình: npm run check:smtp   (hoặc: npm run check:smtp -- ban@gmail.com để gửi thử)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
