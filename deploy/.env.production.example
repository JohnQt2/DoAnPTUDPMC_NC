# setup-vps.sh sẽ copy file này thành /var/www/hanzi4u/backend/.env (KHÔNG commit file .env thật)
PORT=5000
NODE_ENV=production
DATABASE_URL="file:/var/www/hanzi4u/data/prod.db"

# setup-vps.sh tự sinh 2 secret này
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

REDIS_URL="redis://127.0.0.1:6379"
USE_MEMORY_REDIS=true

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://hanzi4u.id.vn/api/v1/auth/google/callback"

CLIENT_URL="https://hanzi4u.id.vn"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

